<mujoco model="clearvla lab scene v0">
  <!-- Franka Panda from MuJoCo Menagerie (envs/franka, BSD-3). Table = floor plane at z=0. -->
  <include file="franka/panda.xml"/>
  <compiler meshdir="franka/assets"/>
  <option timestep="0.002" integrator="implicitfast"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global offwidth="224" offheight="224"/>
  </visual>
  <asset>
    <material name="table_mat" rgba="0.28 0.30 0.33 1"/>
    <material name="tube_mat" rgba="0.9 0.9 0.9 1"/>
    <material name="tube_alpha" rgba="0.9 0.9 0.9 0.3"/>
    <material name="rack_mat" rgba="0.2 0.2 0.22 1"/>
  </asset>
  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="table_mat"/>
    <camera name="front" pos="0.5 -0.65 0.45" xyaxes="1 0 0 0 0.496 0.868" fovy="50"/>
    <body name="tube" pos="0.5 0 0.051">
      <freejoint name="tube_free"/>
      <geom name="tube_geom" type="cylinder" size="0.014 0.05" material="tube_mat" mass="0.02" friction="1 0.005 0.0001"/>
    </body>
    <body name="rack" pos="0.62 0.15 0.03">
      <geom name="rack_geom" type="box" size="0.06 0.03 0.03" material="rack_mat"/>
    </body>
  </worldbody>
</mujoco>
